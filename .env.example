# 高德开放平台 Web 端 Key（必填才能显示高德底图）
VITE_AMAP_KEY=

# 控制台「安全密钥」jscode，可选
VITE_AMAP_SECURITY_CODE=

# 识鱼走火山方舟豆包。不能自动登录 doubao.com 填表。
# Key 在 https://console.volcengine.com/ark 申请，填到 FISH_ID_API_KEY。
# 部署 Zeabur 时把下列变量配在控制台，不要上传本文件。
FISH_ID_SITE_URL=https://www.doubao.com
FISH_ID_AGENT_ID=
FISH_ID_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FISH_ID_MODEL=doubao-seed-2-1-turbo-260628
FISH_ID_API_KEY=

# 鱼情摘要 / 入库补全，与识鱼共用豆包。可与 FISH_ID_API_KEY 填同一把。
FISH_SCOUT_AI_API_KEY=

# 渔获库：飞书多维表。先 npm run feishu:login，再 npm run feishu:provision。
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_AS=user

# Supabase 账号（可选）。Project URL 在控制台 Settings → Data API。
# 前端只用 publishable key。secret 不要加 VITE_ 前缀，不要提交 git。
# 公网群聊：在 SQL Editor 执行 supabase/chat_messages.sql，并打开该表 Realtime。
# 资料/渔获/点赞等：再执行 supabase/user_data.sql。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
